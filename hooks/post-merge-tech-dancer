#!/usr/bin/env bash
# post-merge hook for the tech-dancer checkout — TRACKED copy, kept in
# the remote-server repo because that is where the S5 automation
# lives. Installed by scripts/setup-hooks.sh into
# ~/repos/tech-dancer/.git/hooks/post-merge. (Git never tracks
# .git/hooks itself, so this file is the source of truth; re-run the
# setup script after a fresh clone.)
#
# If a merge changes package.json or pnpm-lock.yaml, refresh dependencies.
# Missing tooling and install failures are reported without blocking a merge.
set -u
cd "$(git rev-parse --show-toplevel 2>/dev/null || echo .)" || exit 0

changed="$(git diff --name-only ORIG_HEAD HEAD 2>/dev/null \
  || git diff --name-only 'HEAD@{1}' HEAD 2>/dev/null || true)"
[ -z "$changed" ] && exit 0

if printf '%s\n' "$changed" | grep -Eq '^(package\.json|pnpm-lock\.yaml)'; then
  if command -v pnpm >/dev/null 2>&1; then
    echo "[post-merge] dependencies changed — pnpm install --frozen-lockfile..."
    pnpm install --frozen-lockfile \
      || echo "[post-merge] pnpm install failed (node_modules may be stale)"
  else
    echo "[post-merge] dependencies changed — pnpm not found; run pnpm install --frozen-lockfile manually"
  fi
fi

exit 0
