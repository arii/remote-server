# Internal router behind oauth2-proxy (single OAuth gate, single TLS port).
# oauth2-proxy -> caddy:8080 -> terminal (/), buttons (/buttons*), or code-server (/code*).
# Caddy reverse_proxy handles websocket upgrades automatically (ttyd and code-server).
# No TLS here: oauth2-proxy terminates TLS; this port is compose-network
# only and is never published to the host.
:8080 {
	handle /buttons* {
		uri strip_prefix /buttons
		reverse_proxy buttons:8000
	}

	# Exact /code (no trailing slash) must redirect to /code/ FIRST:
	# code-server answers / with a relative redirect (./?folder=...),
	# which a browser sitting on /code would resolve to / (the terminal).
	handle /code {
		# Explicit * matcher: this caddy build requires matcher+target form.
		redir * /code/
	}

	handle /code* {
		uri strip_prefix /code
		reverse_proxy code-server:8080
	}

	handle {
		reverse_proxy terminal:7681
	}
}
