# Internal router behind oauth2-proxy (single OAuth gate, single TLS port).
# oauth2-proxy -> caddy:8080 -> terminal (/), buttons (/buttons*), code-server (/code*), or hrm (/hrm*).
# Caddy reverse_proxy handles websocket upgrades automatically (ttyd and code-server).
# No TLS here: oauth2-proxy terminates TLS; this port is compose-network
# only and is never published to the host.
:8080 {
	handle /buttons* {
		uri strip_prefix /buttons
		reverse_proxy buttons:8000
	}

	# Exact /code (no trailing slash) must redirect to /code/ FIRST:
	# code-server answers / with a relative redirect (./?folder=...),
	# which a browser sitting on /code would resolve to / (the terminal).
	handle /code {
		# Explicit * matcher: this caddy build requires matcher+target form.
		redir * /code/
	}

	handle /code* {
		uri strip_prefix /code
		reverse_proxy code-server:8080
	}

	# CDP-direct shared viewer: raw screencast over one websocket +
	# CDP input relay, no VNC in the loop. The viewer is served by
	# the buttons backend at /cdp-stream (pass the prefix through).
	# Bare path redirects to the slash form (same convention as /neko):
	# the backend mount 404s without it.
	handle /cdp-stream {
		redir * /cdp-stream/
	}
	handle /cdp-stream* {
		header -X-Frame-Options
		# No-store: the viewer ships new JS with deploys and a cached
		# copy silently pins old behavior (e.g. a dead URL box) with
		# zero errors to diagnose. Edge-owned; the app must not set it.
		header Cache-Control "no-store"
		reverse_proxy buttons:8000 {
			transport http {
				dial_timeout 10s
			}
		}
	}

	# Neko trial (user-requested evaluation): neko serves its own /neko
	# prefix (NEKO_PATH_PREFIX), so pass through unstripped like /cdp-stream.
	# Signaling rides this route; WebRTC media uses host UDP 52000-52100
	# (needs the same range forwarded on the router). Public entry:
	# https://<host>:8443/neko/ (behind the oauth2-proxy gate).
	handle /neko {
		redir * /neko/
	}
	handle /neko* {
		header -X-Frame-Options
		reverse_proxy neko:8080 {
			transport http {
				dial_timeout 10s
			}
		}
	}

	# Repo previews: one block per /<name>, no strip (the app serves its
	# own basePath). Template:
	#   handle /<name>* {
	#   	reverse_proxy <upstream>
	#   }
	# Full pattern + app contract: docs/repo-previews.md.
	# HRM dashboard (dev server :3000 inside the terminal container; the
	# compose service name tracks it across container recreates).
	# Public entry: https://<host>:8443/hrm (behind the oauth2-proxy gate).
	handle /hrm* {
		reverse_proxy terminal:3000
	}

	handle {
		reverse_proxy terminal:7681
	}
}
