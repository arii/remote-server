{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "scripts/*.mjs",
    "buttons/ux/*.js",
    "backend/ts_check.js"
  ],
  "ignorePatterns": [
    "terminal/**",
    ".agents/**",
    ".claude/**",
    ".github/skills/**",
    "backend/api/routers/vendor/**"
  ],
  "rules": {
    "unused-export": "warn",
    "complexity-cyclomatic": "warn",
    "complexity-cognitive": "warn",
    "complexity-crap": "warn"
  }
}
