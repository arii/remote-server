# secrets — never commit (covers .env, .env.ci, .env.local, private keys, ...)
.env*
*.pem
*.key

# docker / runtime state
data/
volumes/

# OS / editor noise
.DS_Store
*.swp
*~

# restic / backup scratch
*.snapshot
/restore-test/

# Python bytecode
__pycache__/
*.pyc

# Dynamic Agent Context (Untracked) — td context-warm output,
# like tech-dancer: warming must never dirty the checkout
.agent-context.json

# Boomtick CLI artifacts
.boomtick/

# UX preview toolkit artifacts (local development)
node_modules/
buttons/ux/shots/
buttons/ux/node_modules/
buttons/ux/.scratch*
buttons/ux/scratch-ledger.json
*.scratch.json

# Dependencies and cache
.pnpm-store/
.fallow/

# Deep Agents: track only reusable tools + requirements. Spikes, env,
# index, and logs stay on disk, out of git.
deep-agent/*
!deep-agent/search_docs.py
!deep-agent/ledger.py
!deep-agent/requirements.txt
!deep-agent/triage_explainer.py
!deep-agent/triage_fanout.py
!deep-agent/resolve_conflicts.py
!deep-agent/build_index.py
!deep-agent/s5tools.py
!deep-agent/model_router.py
!deep-agent/retrieval.py
!deep-agent/chat_agent.py

# Agent skills (Untracked) — provisioned per-machine, never committed.
# Present on disk (host bind mount, safe across container recreates),
# absent from git. Re-provision by reinstalling from
# langchain-ai/langchain-skills (see docs/deepagents.md). Note: plain
# `git clean -fd` preserves these; `git clean -fdx` would remove them.
.agents/
skills-lock.json
