# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with: openssl rand -base64 32

# --- Public terminal ingress: Ari's EXISTING dynamic DDNS + certbot ---
# TERMINAL_DOMAIN must be a hostname your existing DDNS keeps pointed at this
# box AND a domain certbot already holds a certificate for
# (check with: certbot certificates). No new DNS or certbot setup is needed.
# If you use a different DDNS provider, only this hostname changes.
TERMINAL_DOMAIN=yourname.ddns.net
# The separate port your existing certbot-served site already uses.
# Your router must forward TERMINAL_PORT/tcp to this box (it presumably
# already does for your existing service — reuse that forwarding).
TERMINAL_PORT=8443
# Host path to certbot's directory; mounted READ-ONLY into oauth2-proxy.
# We mount the whole dir (not individual files) because live/ holds symlinks
# that certbot re-points on every renewal — file mounts would go stale.
LE_DIR=/etc/letsencrypt
# -> cert used: ${LE_DIR}/live/${TERMINAL_DOMAIN}/fullchain.pem
# -> key used:  ${LE_DIR}/live/${TERMINAL_DOMAIN}/privkey.pem

# --- GitHub OAuth (the gate in front of the terminal) ---
# Create at https://github.com/settings/developers -> New OAuth App.
# Authorization callback URL — GitHub ALLOWS non-443 ports, but the URL must
# match EXACTLY what you register here:
#   https://<TERMINAL_DOMAIN>:<TERMINAL_PORT>/oauth2/callback
GITHUB_USER=arii
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_REDIRECT_URL=https://yourname.ddns.net:8443/oauth2/callback

# --- Tailscale (VPN mesh for admin access; the terminal does NOT need it) ---
# Reusable auth key from https://login.tailscale.com/admin/settings/keys
# (must be reusable: the entrypoint re-runs `tailscale up` on restart).
TS_AUTHKEY=
TS_HOSTNAME=s5

# --- Terminal image build pins (see terminal/Dockerfile) ---
TTYD_VERSION=1.7.7
ZELLIJ_VERSION=0.45.1
# Optional: use the CI-built image from GHCR instead of building locally on
# the box. Uncomment after the first successful CI run on main:
# TERMINAL_IMAGE=ghcr.io/arii/remote-server-terminal:latest
# (then: docker login ghcr.io && docker compose pull terminal && docker compose up -d)

