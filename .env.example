# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with: openssl rand -base64 32

# Host user home path for volume interpolation (defaults to /home/ari)
HOST_HOME=/home/ari

# --- Public terminal ingress: Ari's EXISTING dynamic DDNS + certbot ---
# TERMINAL_DOMAIN must be a hostname your existing DDNS keeps pointed at this
# box AND a domain certbot already holds a certificate for
# (check with: certbot certificates). No new DNS or certbot setup is needed.
# If you use a different DDNS provider, only this hostname changes.
TERMINAL_DOMAIN=yourname.ddns.net
# The separate port your existing certbot-served site already uses.
# Your router must forward TERMINAL_PORT/tcp to this box (it presumably
# already does for your existing service — reuse that forwarding).
TERMINAL_PORT=8443
# Host path to certbot's directory; mounted READ-ONLY into oauth2-proxy.
# We mount the whole dir (not individual files) because live/ holds symlinks
# that certbot re-points on every renewal — file mounts would go stale.
LE_DIR=/etc/letsencrypt
# -> cert used: ${LE_DIR}/live/${TERMINAL_DOMAIN}/fullchain.pem
# -> key used:  ${LE_DIR}/live/${TERMINAL_DOMAIN}/privkey.pem

# --- GitHub OAuth (the gate in front of the terminal) ---
# Create at https://github.com/settings/developers -> New OAuth App.
# Authorization callback URL — GitHub ALLOWS non-443 ports, but the URL must
# match EXACTLY what you register here:
#   https://<TERMINAL_DOMAIN>:<TERMINAL_PORT>/oauth2/callback
GITHUB_USER=arii
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_REDIRECT_URL=https://yourname.ddns.net:8443/oauth2/callback

# --- GitHub webhook auto-pull (buttons page) ---
# HMAC secret shared with GitHub (Repo -> Settings -> Webhooks ->
# Secret). Generate with: openssl rand -hex 32
# The SAME value goes in each repo's webhook settings (remote-server
# and tech-dancer). Empty/unset = the webhook endpoint refuses
# everything; the buttons page still works normally.
# WEBHOOK_SECRET=

# --- Proactive Notifications & Scheduled Digest ---
# Push notifications via ntfy (e.g. ntfy.sh/<NTFY_TOPIC>) or custom webhook URL
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=
NOTIFICATION_WEBHOOK_URL=
# Scheduled digest interval in hours (default: 12, 0 to disable)
DIGEST_INTERVAL_HOURS=12
# Comma-separated list of events to trigger notifications: ci_fail, conflict
NOTIFY_EVENTS=ci_fail,conflict
NOTIFIER_INTERVAL_SECONDS=300

# --- Tailscale (VPN mesh for admin access; the terminal does NOT need it) ---
# Reusable auth key from https://login.tailscale.com/admin/settings/keys
# (must be reusable: the entrypoint re-runs `tailscale up` on restart).
TS_AUTHKEY=
TS_HOSTNAME=s5

# --- Terminal image build pins (see terminal/Dockerfile) ---
TTYD_VERSION=1.7.7
ZELLIJ_VERSION=0.45.1
# Optional: pin the terminal image or build locally instead of using the
# default CI-built image (ghcr.io/arii/remote-server-terminal:latest).
# TERMINAL_IMAGE=ghcr.io/arii/remote-server-terminal:sha-<sha>
# (or: docker compose build terminal — build tags the local image with
# this same name, so `up` uses the local build.)

# ================= ACTIVE: Pi + Ollama (2026-10-27) ==========================
# --- Ollama (local LLM inference, CPU-only) ---
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=1
# Space-separated model tags pulled by scripts/pull-models.sh
OLLAMA_MODELS="qwen2.5-coder:7b qwen2.5-coder:14b qwen3:8b qwen3:14b"
# Custom Modelfile context window and temperature tuned during scripts/pull-models.sh
OLLAMA_NUM_CTX=16384
OLLAMA_TEMPERATURE=0.2

# --- BoomTick MCP + gh (see docs/pi-setup.md § BoomTick MCP tools) ---
# Fine-grained GitHub PAT with repo scope, for the boomtick-mcp server and
# gh inside the terminal container. Without it, only public read-only
# GitHub ops work. Create at https://github.com/settings/tokens (fine-grained,
# resource owner arii, repository access: tech-dancer + any repo you point
# the server at, permissions: contents + pull requests read/write).
# BOOMTICK_GITHUB_TOKEN=
# GitHub App credentials for BoomTick (td doctor / GitHub App auth):
# GITHUB_APP_ID=4321063
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# --- DeepAgents harness verification (see docs/deepagents.md) ---
# Nebius API key: use ONLY to verify the DeepAgents harness before the
# local Ollama route works. Treat every call as metered: keep prompts
# and iterations minimal.
# NEBIUS_API_KEY=
# Nebius fallback model + endpoint for deep-agent/model_router.py (non-secret;
# key above stays required). Leave commented to use the router's cheap default.
# NEBIUS_MODEL=zai-org/GLM-5.3-Flash
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Lifetime metered-spend cap in USD (model_router gate + budget UI).
# 0 blocks every metered call; commented/unset means uncapped.
# NEBIUS_SPEND_CAP_USD=
# Agent drawer default provider — the cutoff flip (issue #399).
# ordered_providers() in backend/exec/agent_turn.py reads this per
# request; the drawer defaults to providers[0]. Default muse;
# muse|agy (case/whitespace-insensitive). Unset/unknown/blank keeps
# the default muse-first order (fail safe).
# Flip muse->agy mid-cutoff with env only (no code change):
#   1. set AGENT_DEFAULT_PROVIDER=agy in .env
#   2. docker compose up -d --build buttons
#   3. verify GET /api/agent/providers lists agy first
# AGENT_DEFAULT_PROVIDER=muse
# Uncarded-model metered rates in $/1M tokens (in, out) for the
# spend card (deep-agent/pricing.py). Apply ONLY to models missing
# from RATE_CARD — a card match always wins, and ollama:* stays
# free. BOTH must be set and parse as floats, else no override and
# uncarded models show a bare "metered" tag. Setting both also
# lifts the spend-cap "unverifiable" block for unrated runs.
# METERED_RATE_IN_PER_1M=
# METERED_RATE_OUT_PER_1M=
# --- LangSmith tracing (deep-agent observability layer 4) ---
# Uncomment + fill to send agent traces to LangSmith. Needs BOTH the
# flag and the key; without them tracing stays off and runs are
# unaffected. Project is optional (server default otherwise).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=remote-server

# ================= ON HOLD: remaining agent harness ==========================
# --- Gemini API (heavy agentic code review; $10 credit) ---
# Paid key from Google AI Studio. Billed against the GCP credit.
# GEMINI_API_KEY=
# --- GitHub Actions self-hosted runner ---
# Ephemeral registration token: re-issue at deploy time via
# gh api repos/<owner>/<repo>/actions/runners/registration-token
# REPO_URL=https://github.com/arii/<repo>
# RUNNER_TOKEN=
# RUNNER_NAME=s5
# RUNNER_LABELS=self-hosted,linux,local-llm
