# Space-separated model tags pulled by scripts/pull-models.sh
# OLLAMA_MODELS="qwen3:14b qwen2.5-coder:14b qwen3:8b"
# --- Gemini API (heavy agentic code review; $10 credit) ---
# Paid key from Google AI Studio. Billed against the GCP credit.
# GEMINI_API_KEY=
# --- GitHub Actions self-hosted runner ---
# Ephemeral registration token: re-issue at deploy time via
# gh api repos/<owner>/<repo>/actions/runners/registration-token
# REPO_URL=https://github.com/arii/<repo>
# RUNNER_TOKEN=
# RUNNER_NAME=s5
# RUNNER_LABELS=self-hosted,linux,local-llm
