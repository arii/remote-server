{
  "mcpServers": {
    "boomtick": {
      "args": [],
      "command": "/usr/local/bin/boomtick-mcp",
      "env": {
        "APP_ID": "4321063",
        "APP_PRIVATE_KEY": "!cat /srv/remote-server/boomtick.2026-10-28.private-key.pem",
        "BOOMTICK_REPO_PATH": "/srv/repos/tech-dancer",
        "GITHUB_APP_ID": "4321063",
        "GITHUB_APP_PRIVATE_KEY": "!cat /srv/remote-server/boomtick.2026-10-28.private-key.pem",
        "GITHUB_OWNER": "arii",
        "GITHUB_PRIVATE_KEY": "!cat /srv/remote-server/boomtick.2026-10-28.private-key.pem",
        "GITHUB_REPO": "tech-dancer",
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      },
      "exposure": "direct",
      "toolExposure": {
        "github_get_pr_diff": "direct",
        "github_search_open_prs": "direct",
        "github_get_pr": "direct",
        "github_issue_view": "direct",
        "repo_read_agent_context": "direct",
        "repo_read_ci_logs": "direct",
        "repo_get_changed_files": "direct",
        "repo_run_tests": "direct",
        "td_init_and_rag": "direct",
        "td_validate_issue": "direct",
        "td_verify_scope": "direct",
        "td_audit_worktree": "direct",
        "worktree_create": "direct",
        "worktree_list": "direct",
        "worktree_remove": "direct",
        "agent_submit_pr": "direct",
        "*.*": "hidden"
      }
    },
    "browser-mcp": {
      "$comment": "browsermcp pinned (#524): bump deliberately — check https://github.com/BrowserMCP/mcp/releases, test locally, then update this pin AND the docs/workstation-onboarding.md shim to the same version in one commit.",
      "args": [
        "-y",
        "@browsermcp/mcp@2.4.0"
      ],
      "command": "npx",
      "env": {
        "BROWSER_MCP_HOME": "/root/.local/share/browsermcp"
      },
      "exposure": "direct"
    }
  }
}
